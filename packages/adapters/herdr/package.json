{
  "name": "@raggle-ai/herdr-adapter",
  "version": "0.1.0",
  "description": "Open discovered Raggle projects in Herdr",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "raggle-herdr-open": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "fix-lint": "prettier --write \"src/**/*.ts\"",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@raggle/raggle-local",
  "version": "0.1.0",
  "description": "Local project discovery and expansion logic for Raggle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/local.git"
  },
  "bugs": {
    "url": "https://github.com/raggle-ai/local/issues"
  },
  "homepage": "https://github.com/raggle-ai/local#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "fix-lint": "prettier --write \"src/**/*.ts\""
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}

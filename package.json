{
  "name": "@raggle-ai/local",
  "version": "0.4.0",
  "description": "Local project discovery and expansion logic for Raggle",
  "license": "MIT",
  "author": "Raggle AI",
  "packageManager": "npm@11.17.0",
  "keywords": [
    "raggle",
    "projects",
    "git",
    "local-discovery"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/local.git"
  },
  "bugs": {
    "url": "https://github.com/raggle-ai/local/issues"
  },
  "homepage": "https://github.com/raggle-ai/local#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "raggle-local": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:native && tsc",
    "build:native": "napi build --platform --release --cwd native/scanner --output-dir ../../dist/native --js index.js --dts index.d.ts",
    "build:all": "npm run build && npm run build --workspaces",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces",
    "lint:all": "npm run lint && npm run lint --workspaces",
    "test:all": "npm run test --workspaces --if-present",
    "raycast": "npm --prefix apps/raycast run dev",
    "prepack": "npm run build",
    "test:updates": "npm run build && node scripts/test-project-updates.mjs",
    "test:project-config": "npm run build && node scripts/test-project-config.mjs",
    "test:public-api": "npm run build && node scripts/test-public-api.mjs",
    "test:cli": "npm run build && node scripts/test-cli.mjs",
    "test:scanner": "npm run build && node scripts/test-scanner.mjs",
    "test:pack-consumer": "npm run build && node scripts/check-packed-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "fix-lint": "prettier --write \"src/**/*.ts\"",
    "bench": "npm run build && node scripts/benchmark-folder-discovery.mjs",
    "bench:projects-db": "npm run build && node scripts/benchmark-project-db-folder-fetch.mjs",
    "bench:data": "npm run build && node scripts/benchmark-data-folder-fetch.mjs",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "publish:all": "node scripts/publish-packages.mjs --provenance"
  },
  "workspaces": [
    "packages/adapters/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2",
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}

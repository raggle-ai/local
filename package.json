{
  "name": "@raggle-ai/local",
  "version": "0.1.0",
  "description": "Local project discovery and expansion logic for Raggle",
  "license": "MIT",
  "author": "Andrew Maguire",
  "keywords": [
    "raggle",
    "projects",
    "git",
    "local-discovery"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/local.git"
  },
  "bugs": {
    "url": "https://github.com/raggle-ai/local/issues"
  },
  "homepage": "https://github.com/raggle-ai/local#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "fix-lint": "prettier --write \"src/**/*.ts\"",
    "bench": "node scripts/benchmark-folder-discovery.mjs",
    "bench:projects-db": "npm run build && node scripts/benchmark-project-db-folder-fetch.mjs",
    "bench:data": "npm run build && node scripts/benchmark-data-folder-fetch.mjs",
    "publish:dry-run": "npm publish --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
